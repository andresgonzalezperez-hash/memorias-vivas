# Memorias Vivas Studio - Variables de Entorno
# Copiar este archivo a .env y rellenar con credenciales reales (nunca subir .env a Git)

# Motor de Redacción Biográfica y Transcripción (Zero Data Retention API)
GEMINI_API_KEY=

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Orquestación n8n en Homelab (Puerto inmutable 5678)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/memorias-vivas

# Pasarela de Pagos (Stripe + Klarna)
STRIPE_WEBHOOK_SECRET=
